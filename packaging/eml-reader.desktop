[Desktop Entry]
Type=Application
Name=EML Reader
GenericName=E-Mail Viewer
Comment=View and analyse e-mail files (.eml, .msg, mbox): attachments, header analysis, phishing checks
Exec=eml-reader %F
Icon=eml-reader
Terminal=false
Categories=Office;Email;Viewer;
MimeType=message/rfc822;application/vnd.ms-outlook;application/mbox;
Keywords=EML;E-Mail;Mail;Message;Header;Attachment;SPF;DKIM;
StartupWMClass=eml-reader
